@page "/"
@using Client.Models

@inject IDataService DataService
@inject IReadOnlyList<MapInfo> Maps
@inject IJSRuntime Js
@inject IWebHostEnvironment Environment

<MudGrid class="d-flex">
    <MudItem xs="2">
        <MudImage Src="images/Carrot.webp" Style="height: 56px; width: auto; transform: scaleX(-1); float: left;"
                  Alt="An image of a Carrot."/>
    </MudItem>

    <MudItem xs="8" Class="d-flex align-center justify-center">
        <MudText Typo="Typo.h2" Align="Align.Center" Color="Color.Primary" Style="font-weight: bold;">
            EUREKA MINECRAFT
        </MudText>
    </MudItem>

    <MudItem xs="2">
        <MudImage Src="images/Carrot.webp" Style="height: 56px; width: auto; float: right;"
                  Alt="An image of a Carrot."/>
    </MudItem>

    <MudFlexBreak/>

    @if (_upcomingMap is not null)
    {
        <MudItem xs="12" Class="d-flex justify-center">
            <MudPaper Class="pa-2 text-center" Style="width: 100%;">
                <MudText Align="Align.Center" Color="Color.Tertiary" Typo="Typo.subtitle1">
                    <b>New map launches @_launchDateText</b>
                </MudText>
            </MudPaper>
        </MudItem>
    }

    <MudItem Class="flex-fill" lg="3" xs="12">
        <DiscordCard/>
    </MudItem>

    <MudItem Class="flex-fill" lg="6" xs="12">
        <PlayNowCard OnlineNow="_recentPlayerCount"/>
    </MudItem>

    <MudItem Class="flex-fill" lg="3" xs="12">
        <PatreonCard/>
    </MudItem>

    <MudItem xs="12">
        <div @ref="_carouselContainerRef" style="height: 500px; border-radius: 5px; overflow: hidden;">
            <MudCarousel TData="object" Class="mud-width-full"
                         Style="height: 100%; border-radius: 5px;" ShowArrows="true"
                         AutoCycle="true" AutoCycleTime="TimeSpan.FromSeconds(5)">
                @foreach (var image in _carouselImages)
                {
                    <MudCarouselItem Transition="Transition">
                        <MudPaper>
                            <MudImage Class="responsive-carousel-image" ObjectFit="ObjectFit.Cover"
                                      Src="@image"></MudImage>
                        </MudPaper>
                    </MudCarouselItem>
                }
            </MudCarousel>
        </div>
    </MudItem>

    <MudItem xs="12">

        @if (_activeMap is not null)
        {
            @* ReSharper disable once Html.PathError *@
            <iframe class="map-iframe" src="/map/?world=minecraft_overworld" width="100%" height="500px"></iframe>
        }
        else
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center justify-center text-center"
                      Style="min-height: 220px;">
                <MudText Typo="Typo.h5">The live map will be back with the next map</MudText>
                <MudText Typo="Typo.body1" Class="mt-2">
                    @if (_upcomingMap is not null)
                    {
                        <span>Map @_upcomingMap.Name launches on @_launchDateText.</span>
                    }
                    else
                    {
                        <span>Check back for details about the next map launch.</span>
                    }
                </MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private const Transition Transition = MudBlazor.Transition.Fade;
    private static readonly HashSet<string> CarouselImageExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".jpg", ".jpeg", ".png", ".gif", ".webp"
    };

    private List<string> _carouselImages = [];
    private int _recentPlayerCount;
    private MapInfo? _activeMap;
    private MapInfo? _upcomingMap;
    private string _launchDateText = string.Empty;

    private ElementReference _carouselContainerRef;
    private IJSObjectReference? _jsModule;

    protected override async Task OnInitializedAsync()
    {
        _recentPlayerCount = await DataService.GetRecentPlayerCount();
        var now = DateTimeOffset.UtcNow;
        _activeMap = Maps
            .Where(map => now >= map.StartDateUtc && now < map.EndDateUtc)
            .OrderByDescending(map => map.StartDateUtc)
            .FirstOrDefault();
        _upcomingMap = Maps.Where(map => map.StartDateUtc > now)
            .OrderBy(map => map.StartDateUtc)
            .FirstOrDefault();

        if (_upcomingMap is not null)
        {
            _launchDateText = _upcomingMap.StartDateUtc.UtcDateTime.ToString(
                "MMMM d, yyyy 'at' h:mm tt 'UTC'", System.Globalization.CultureInfo.InvariantCulture);
        }

        _carouselImages = Directory.EnumerateFiles(Path.Combine(Environment.WebRootPath, "images", "carousel"))
            .Where(file => CarouselImageExtensions.Contains(Path.GetExtension(file)))
            .Select(file => $"images/carousel/{Path.GetFileName(file)}")
            .ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await Js.InvokeAsync<IJSObjectReference>("import", "/Components/Pages/Home.razor.js");
            await _jsModule.InvokeVoidAsync("initCarouselAutoHeight", _carouselContainerRef, 500);
            if (_upcomingMap is not null)
            {
                _launchDateText = await _jsModule.InvokeAsync<string>(
                    "formatDateTimeLocal",
                    _upcomingMap.StartDateUtc.ToString("O", System.Globalization.CultureInfo.InvariantCulture));
                StateHasChanged();
            }
        }
    }

}