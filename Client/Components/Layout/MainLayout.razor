@using MudBlazor.Utilities
@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Default">
        <MudSpacer />
        <CascadingValue Value="_isDarkMode">
            <NavMenu IsDarkModeChanged="ChangeTheme"/>
        </CascadingValue>
        <MudSpacer />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pt-8 pb-8">

            @Body

        </MudContainer>
    </MudMainContent>
</MudLayout>

@code{

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = MudColor.Parse("#FF8C00"),
            Secondary = MudColor.Parse("#4CAF50"),
            Background = MudColor.Parse("rgb(246, 254, 250)"),
            Surface = MudColor.Parse("#FFFFFF"),
            AppbarBackground = MudColor.Parse("#F0F8F4"),
            AppbarText = MudColor.Parse("#424242")
        },
        PaletteDark = new PaletteDark
        {
            Primary = MudColor.Parse("#FF8C00"),
            Secondary = MudColor.Parse("#4CAF50"),
            Background = MudColor.Parse("#36322D"),
            Surface = MudColor.Parse("#423C36"),
            AppbarBackground = MudColor.Parse("#2C2824"),
            AppbarText = MudColor.Parse("#E0E0E0")
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px"
        }
    };

    private bool _isDarkMode = true;

    private void ChangeTheme(bool isDarkMode)
    {
        _isDarkMode = isDarkMode;
    }

}