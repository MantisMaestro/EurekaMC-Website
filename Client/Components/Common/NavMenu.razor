@using Client.Models
@inject IReadOnlyList<MapInfo> Maps

<div class="d-flex align-center" style="gap: 16px;">
    <MudButton Href="/" Color="Color.Inherit">
        Home
    </MudButton>
    @if (_hasActiveMap)
    {
        <MudButton Href="http://173.240.152.72:25575/?world=world" Color="Color.Inherit">
            Map
        </MudButton>
    }
    <MudButton Href="/portals" Color="Color.Inherit">
        Portals
    </MudButton>
    <MudButton Href="/players" Color="Color.Inherit">
        Players
    </MudButton>
    <MudButton Href="https://drive.google.com/drive/folders/1zRovaYL_93vQK56hxJDabFZcN3e6rhbk?usp=drive_link" Color="Color.Inherit">
        Map Downloads
    </MudButton>
    <MudIconButton Icon="@(IsDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
                   Color="Color.Inherit"
                   @onclick="ToggleTheme"/>
</div>

@code {
    [CascadingParameter] private bool IsDarkMode { get; set; }

    [Parameter] public EventCallback<bool> IsDarkModeChanged { get; set; }

    private bool _hasActiveMap;

    protected override void OnInitialized()
    {
        var now = DateTimeOffset.UtcNow;
        _hasActiveMap = Maps.Any(map => now >= map.StartDateUtc && now < map.EndDateUtc);
    }

    private async Task ToggleTheme()
    {
        await IsDarkModeChanged.InvokeAsync(!IsDarkMode);
    }

}